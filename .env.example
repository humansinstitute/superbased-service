# HTTP Server
HTTP_PORT=3080
HTTP_HOST=0.0.0.0

# Nostr/CVM Transport
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
SERVER_PRIVATE_KEY=  # Hex private key for server identity (auto-generated if empty)

# Security
ADMIN_NPUBS=  # Comma-separated list of admin npubs (full access)
NIP98_MAX_AGE_SECONDS=60  # Max age for NIP-98 auth events
SERVICE_TOKEN=  # Optional: Bearer token for service-level admin access (bypasses NIP-98)

# Postgres
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/fluxbase

# Optional
LOG_LEVEL=info  # debug, info, warn, error
