# HTTP Server
HTTP_PORT=3080
HTTP_HOST=0.0.0.0

# Nostr/CVM Transport
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
SERVER_PRIVATE_KEY=  # Hex private key for server identity (auto-generated if empty)

# Security
ADMIN_NPUBS=  # Comma-separated list of admin npubs (full access)
NIP98_MAX_AGE_SECONDS=60  # Max age for NIP-98 auth events
SERVICE_TOKEN=  # Optional: Bearer token for service-level admin access (bypasses NIP-98)

# Postgres
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/fluxbase
POSTGRES_HOST_PORT=55432

# Optional
LOG_LEVEL=info  # debug, info, warn, error

# Object Storage (S3-compatible, e.g. MinIO)
STORAGE_ENABLED=true
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_ENDPOINT_PUBLIC=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=superbased
STORAGE_S3_SECRET_KEY=superbased-secret
STORAGE_S3_BUCKET=superbased-storage
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_UPLOAD_TTL_SECONDS=900
STORAGE_PRESIGN_DOWNLOAD_TTL_SECONDS=900
STORAGE_DEFAULT_TTL_SECONDS=2592000
STORAGE_DELETED_RETENTION_SECONDS=86400
STORAGE_MAX_OBJECT_BYTES=104857600
STORAGE_MAX_BYTES_PER_NPUB=1073741824
